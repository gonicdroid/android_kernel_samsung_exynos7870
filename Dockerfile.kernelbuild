FROM ubuntu:22.04

LABEL description="Samsung Exynos7870 kernel build environment"
LABEL kernel="Linux 3.18.140"
LABEL toolchain="Arm GNU Toolchain 12.3 (github.com/sexynos7870/android_prebuilts_gcc_linux-x86_aarch64)"

ENV DEBIAN_FRONTEND=noninteractive

# ── Host build dependencies ───────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    bc \
    bison \
    build-essential \
    cpio \
    curl \
    flex \
    git \
    kmod \
    libelf-dev \
    libssl-dev \
    lzop \
    make \
    python3 \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

# ── Cross-compiler: Arm GNU 12.3 (aarch64-none-linux-gnu) ─────────────────────
RUN git clone --depth=1 \
    -b 12.3_rel1 \
    https://github.com/sexynos7870/android_prebuilts_gcc_linux-x86_aarch64.git \
    /opt/arm-gnu-12.3

# ── Environment ───────────────────────────────────────────────────────────────
ENV PATH="/opt/arm-gnu-12.3/bin:${PATH}"
ENV CROSS_COMPILE=/opt/arm-gnu-12.3/bin/aarch64-none-linux-gnu-
ENV ARCH=arm64
ENV DEFCONFIG=exynos7870-j7xelte_defconfig

WORKDIR /kernel

# ── Default command: build the kernel ────────────────────────────────────────
# The kernel source must be bind-mounted to /kernel.
# Produces:  /kernel/out/arch/arm64/boot/Image
#            /kernel/out/arch/arm64/boot/dtb.img
CMD bash -c "\
    mkdir -p out && \
    echo '==> Toolchain: \$(aarch64-none-linux-gnu-gcc --version | head -1)' && \
    echo '==> Defconfig: ${DEFCONFIG}' && \
    make O=out ARCH=arm64 ${DEFCONFIG} 2>&1 | tee out/build.log && \
    make O=out ARCH=arm64 CROSS_COMPILE=${CROSS_COMPILE} \
         -j\$(nproc) Image dtb.img 2>&1 | tee -a out/build.log && \
    echo '==> Done!' && \
    ls -lh out/arch/arm64/boot/Image out/arch/arm64/boot/dtb.img 2>/dev/null"
